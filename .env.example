# Copiar a .env y completar. .env esta en .gitignore: no lo commitees.

# Conexion a Postgres. Si se omite, el codigo cae al Postgres local del
# docker-compose. En Heroku no hace falta definirla: el addon la inyecta solo.
#
# LOCAL (docker-compose): sslmode=disable esta bien, no sale de tu maquina.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/request_platform?sslmode=disable
#
# PRODUCCION (RDS, Render, Neon, Supabase): sslmode=require, SIEMPRE. Sin eso
# las credenciales y el contenido de las firmas viajan en texto plano por
# internet, y RDS con rds.force_ssl directamente rechaza la conexion con
# "no pg_hba.conf entry ... no encryption".
# DATABASE_URL=postgres://usuario:password@tu-host.rds.amazonaws.com:5432/tu_db?sslmode=require

# Unico administrador. Es el unico que puede crear peticiones; firmarlas es
# publico. Sin estas dos variables nadie puede crear nada.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=cambiame-por-algo-largo-y-aleatorio
# Poner en 1 cuando el sitio corra detras de HTTPS, para que la cookie de
# sesion solo viaje cifrada.
COOKIE_SECURE=0
# Poner en 1 solo si el front vive en OTRO dominio que la API (por ejemplo dos
# apps de Heroku distintas). Sin esto el navegador no manda la cookie de sesion
# en pedidos cross-site y el admin no puede crear nada. Exige COOKIE_SECURE=1.
COOKIE_CROSS_SITE=0

# Origen exacto del front, para CORS. En produccion, la URL de la app del front.
WEB_ORIGIN=http://localhost:5173

# --- Almacenamiento de los PDF (S3) ---
# Mismos nombres que auth-api-be, para no tener dos convenciones en el stack.
#
# Sin AWS_BUCKET y AWS_REGION, los PDF nuevos se guardan en la columna bytea de
# Postgres, que es como funcionaba antes: la falta de credenciales no deja la
# aplicacion sin poder crear peticiones. Las peticiones que ya tienen el PDF en
# la base se siguen leyendo de ahi para siempre, se configure S3 o no.
# AWS_REGION=us-east-1
# AWS_BUCKET=mi-bucket
# Opcionales: sin ellas se usa la cadena por defecto del SDK (rol de la
# instancia, perfil de ~/.aws, variables del entorno).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Prefijo de las claves dentro del bucket. Default: petitions
# AWS_PREFIX=petitions
# Solo para un S3 que no es el de AWS (MinIO, Cloudflare R2) o para tests.
# En produccion contra AWS va vacio.
# AWS_ENDPOINT_URL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucuenta@gmail.com
# App Password de 16 caracteres, NO la contrasena de la cuenta.
# Se genera en https://myaccount.google.com/apppasswords (requiere 2FA activo).
SMTP_PASS=xxxxxxxxxxxxxxxx
# Opcional: si se omite, se usa SMTP_USER (Gmail exige que coincidan).
SMTP_FROM=tucuenta@gmail.com
# Nombre visible en la bandeja del destinatario. Default: "Peticiones".
SMTP_FROM_NAME=Peticiones
