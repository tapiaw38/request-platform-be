# Copiar a api/.env y completar. api/.env esta en .gitignore: no lo commitees.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucuenta@gmail.com
# App Password de 16 caracteres, NO la contrasena de la cuenta.
# Se genera en https://myaccount.google.com/apppasswords (requiere 2FA activo).
SMTP_PASS=xxxxxxxxxxxxxxxx
# Opcional: si se omite, se usa SMTP_USER (Gmail exige que coincidan).
SMTP_FROM=tucuenta@gmail.com
# Nombre visible en la bandeja del destinatario. Default: "Peticiones".
SMTP_FROM_NAME=Peticiones
